datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model User {
  id                   String                 @id @default(uuid())
  name                 String
  email                String                 @unique
  passwordHash         String?                @map("password_hash")   // Nullable for Google-only users
  baseCurrency         String                 @default("USD") @map("base_currency")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  isVerified           Boolean                @default(false) @map("is_verified")

  // OAuth fields
  googleId             String?                @unique @map("google_id")
  avatar               String?                // Profile picture URL from Google
  authProvider         String                 @default("email") @map("auth_provider") // email | google
  lastLogin            DateTime?              @map("last_login")

  // Onboarding & Profile details
  displayName          String?                @map("display_name")
  country              String?
  timezone             String?
  monthlyIncome        String?                @map("monthly_income")
  preferredGoal        String?                @map("preferred_goal")
  shortTermGoal        String?                @map("short_term_goal")
  longTermGoal         String?                @map("long_term_goal")
  onboardingComplete   Boolean                @default(false) @map("onboarding_complete")

  // Subscription Plan / Entitlement
  plan                 String                 @default("FREE") @map("plan")

  // Legal Consent & Terms Acceptance
  termsAcceptedAt      DateTime?              @map("terms_accepted_at")
  termsVersion         String?                @default("1.0") @map("terms_version")

  // Relations
  settings             Settings?
  wallets              Wallet[]
  creditCards          CreditCard[]
  categories           Category[]
  transactions         Transaction[]
  budgets              Budget[]
  goals                Goal[]
  recurringTransactions RecurringTransaction[]
  subscriptions        Subscription[]
  receipts             Receipt[]
  notifications        Notification[]
  bills                Bill[]
  createdGroups        Group[]                @relation("GroupCreator")
  groups               Group[]                @relation("GroupMembers")
  paidGroupExpenses    GroupExpense[]         @relation("PaidGroupExpenses")
  groupSplits          GroupExpenseSplit[]
  sentSettlements      GroupSettlement[]      @relation("SentSettlements")
  receivedSettlements  GroupSettlement[]      @relation("ReceivedSettlements")

  sentRequests         Friend[]               @relation("SentRequests")
  receivedRequests     Friend[]               @relation("ReceivedRequests")
  friendSentSettlements FriendSettlement[]    @relation("FriendSentSettlements")
  friendReceivedSettlements FriendSettlement[] @relation("FriendReceivedSettlements")

  // Enterprise Relations
  workspaceMembers     WorkspaceMember[]
  auditLogs            AuditLog[]

  // Friend balance relations
  friendBalancesFrom   FriendBalance[]        @relation("FriendFrom")
  friendBalancesTo     FriendBalance[]        @relation("FriendTo")

  // Documents RAG Relations
  documents            Document[]
  documentChunks       DocumentChunk[]

  @@map("users")
}

model Settings {
  id                 String   @id @default(uuid())
  userId             String   @unique @map("user_id")
  theme              String   @default("light")
  currency           String   @default("USD")
  language           String   @default("en")
  emailNotifications Boolean  @default(true) @map("email_notifications")
  budgetAlerts       Boolean  @default(true) @map("budget_alerts")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  type      String   @default("PERSONAL") // PERSONAL, FAMILY, BUSINESS, PROJECT
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  members               WorkspaceMember[]
  wallets               Wallet[]
  creditCards           CreditCard[]
  categories            Category[]
  transactions          Transaction[]
  budgets               Budget[]
  goals                 Goal[]
  recurringTransactions RecurringTransaction[]
  subscriptions         Subscription[]
  bills                 Bill[]
  automations           Automation[]
  auditLogs             AuditLog[]
  documents             Document[]
  documentChunks        DocumentChunk[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id")
  role        String   @default("VIEWER") // OWNER, ADMIN, EDITOR, VIEWER
  joinedAt    DateTime @default(now()) @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model Wallet {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  workspaceId String?  @map("workspace_id")
  name        String
  type        String   // CASH, BANK, CREDIT_CARD, UPI, OTHER
  balance     Decimal  @default(0.00) @db.Decimal(12, 2)
  color       String   @default("#000000")
  currency    String   @default("USD")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace            Workspace?             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions         Transaction[]          @relation("SourceWallet")
  transfersReceived    Transaction[]          @relation("DestinationWallet")
  recurringTransactions RecurringTransaction[]
  subscriptions        Subscription[]

  @@index([workspaceId])
  @@map("wallets")
}

model CreditCard {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  workspaceId       String?  @map("workspace_id")
  name              String
  limitAmount       Decimal  @map("limit_amount") @db.Decimal(12, 2)
  totalDue          Decimal  @default(0.00) @map("total_due") @db.Decimal(12, 2)
  minimumDue        Decimal  @default(0.00) @map("minimum_due") @db.Decimal(12, 2)
  dueDate           DateTime @map("due_date")
  billingCycleStart Int?     @map("billing_cycle_start")
  billingCycleEnd   Int?     @map("billing_cycle_end")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("credit_cards")
}

model Category {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id") // Null means default/system category
  workspaceId String?  @map("workspace_id")
  name        String
  color       String
  icon        String
  type        String   @default("EXPENSE") // EXPENSE, INCOME
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user                 User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace            Workspace?             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions         Transaction[]
  budgets              Budget[]
  recurringTransactions RecurringTransaction[]

  @@map("categories")
}

model Transaction {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  workspaceId   String?  @map("workspace_id")
  title         String
  amount        Decimal  @db.Decimal(12, 2)
  type          String   @default("EXPENSE") // EXPENSE, INCOME, TRANSFER
  categoryId    String   @map("category_id")
  walletId      String   @map("wallet_id")
  toWalletId    String?  @map("to_wallet_id")
  paymentMethod String?  @map("payment_method")
  tags          String[]
  notes         String?
  receiptUrl    String?  @map("receipt_url")
  date          DateTime
  isRecurring   Boolean  @default(false) @map("is_recurring")
  location      String?
  attachmentUrl String?  @map("attachment_url")
  lastEditorId  String?  @map("last_editor_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  Category   @relation(fields: [categoryId], references: [id])
  wallet    Wallet     @relation("SourceWallet", fields: [walletId], references: [id], onDelete: Cascade)
  toWallet  Wallet?    @relation("DestinationWallet", fields: [toWalletId], references: [id], onDelete: Cascade)
  receipts  Receipt[]

  @@index([workspaceId, date])
  @@index([workspaceId, categoryId])
  @@index([workspaceId, walletId])
  @@index([workspaceId, toWalletId])
  @@map("transactions")
}

model Budget {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  workspaceId String?  @map("workspace_id")
  categoryId  String   @map("category_id")
  amount      Decimal  @db.Decimal(12, 2)
  period      String   @default("MONTHLY") // WEEKLY, MONTHLY
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([workspaceId, categoryId])
  @@index([workspaceId, startDate, endDate])
  @@map("budgets")
}

model Goal {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  workspaceId   String?  @map("workspace_id")
  name          String
  targetAmount  Decimal  @map("target_amount") @db.Decimal(12, 2)
  currentAmount Decimal  @default(0.00) @map("current_amount") @db.Decimal(12, 2)
  targetDate    DateTime? @map("target_date")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@index([workspaceId])
  @@map("goals")
}

model GoalContribution {
  id        String   @id @default(uuid())
  goalId    String   @map("goal_id")
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@map("goal_contributions")
}

model RecurringTransaction {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  workspaceId String?  @map("workspace_id")
  title       String
  amount      Decimal  @db.Decimal(12, 2)
  type        String   @default("EXPENSE") // EXPENSE, INCOME
  categoryId  String   @map("category_id")
  walletId    String   @map("wallet_id")
  frequency   String   // DAILY, WEEKLY, MONTHLY, YEARLY
  startDate   DateTime @map("start_date")
  nextDate    DateTime @map("next_date")
  endDate     DateTime? @map("end_date")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  Category   @relation(fields: [categoryId], references: [id])
  wallet    Wallet     @relation(fields: [walletId], references: [id])

  @@map("recurring_transactions")
}

model Subscription {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  workspaceId     String?  @map("workspace_id")
  name            String
  amount          Decimal  @db.Decimal(12, 2)
  billingCycle    String   @default("MONTHLY") @map("billing_cycle") // MONTHLY, YEARLY
  nextBillingDate DateTime @map("next_billing_date")
  categoryId      String?  @map("category_id")
  walletId        String?  @map("wallet_id")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  wallet    Wallet?    @relation(fields: [walletId], references: [id])

  @@index([workspaceId])
  @@map("subscriptions")
}

model Receipt {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  transactionId String?  @map("transaction_id")
  imageUrl      String   @map("image_url")
  merchant      String?
  amount        Decimal? @db.Decimal(12, 2)
  tax           Decimal? @db.Decimal(12, 2)
  date          DateTime?
  category      String?
  confidence    Float?
  status        String   @default("PENDING") // PENDING, PROCESSED, FAILED
  items         Json?
  createdAt     DateTime @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@index([transactionId])
  @@index([userId])
  @@map("receipts")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  message   String
  type      String   @default("GENERAL") // BUDGET_ALERT, SUBSCRIPTION_DUE, RECURRING_PAYMENT, GOAL_ACHIEVED, BILL_REMINDER, GENERAL
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Bill {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  workspaceId String?  @map("workspace_id")
  name        String
  amount      Decimal  @db.Decimal(12, 2)
  dueDate     DateTime @map("due_date")
  isPaid      Boolean  @default(false) @map("is_paid")
  category    String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("bills")
}

model Group {
  id        String   @id @default(uuid())
  name      String
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  creator     User             @relation("GroupCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  members     User[]           @relation("GroupMembers")
  expenses    GroupExpense[]
  settlements GroupSettlement[]

  @@map("groups")
}

model GroupExpense {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  title     String
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime
  paidById  String   @map("paid_by_id")
  createdAt DateTime @default(now()) @map("created_at")

  group  Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy User                @relation("PaidGroupExpenses", fields: [paidById], references: [id], onDelete: Cascade)
  splits GroupExpenseSplit[]

  @@map("group_expenses")
}

model GroupExpenseSplit {
  id             String   @id @default(uuid())
  groupExpenseId String   @map("group_expense_id")
  userId         String   @map("user_id")
  amountOwed     Decimal  @map("amount_owed") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  expense GroupExpense @relation(fields: [groupExpenseId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("group_expense_splits")
}

model GroupSettlement {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  paidById  String   @map("paid_by_id")
  paidToId  String   @map("paid_to_id")
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  group  Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy User  @relation("SentSettlements", fields: [paidById], references: [id], onDelete: Cascade)
  paidTo User  @relation("ReceivedSettlements", fields: [paidToId], references: [id], onDelete: Cascade)

  @@map("group_settlements")
}

model Automation {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  name        String
  triggerType String   @map("trigger_type") // TRANSACTION_CREATED, BUDGET_OVERRUN, GOAL_COMPLETED
  conditions  Json
  actions     Json
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("automations")
}

model AuditLog {
  id             String   @id @default(uuid())
  workspaceId    String?  @map("workspace_id")
  userId         String   @map("user_id")
  action         String   // TRANSACTION_CREATE, TRANSACTION_UPDATE, TRANSACTION_DELETE, BUDGET_UPDATE, etc.
  resource       String   // Transaction, Budget, Wallet, etc.
  resourceId     String?  @map("resource_id")
  previousValues Json?    @map("previous_values")
  newValues      Json?    @map("new_values")
  createdAt      DateTime @default(now()) @map("created_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("audit_logs")
}

model Friend {
  id           String   @id @default(uuid())
  fromUserId   String   @map("from_user_id")
  toUserId     String   @map("to_user_id")
  status       String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  acknowledged Boolean  @default(false)
  // Balance tracking for Splitwise-style shared expenses
  netBalance   Decimal  @default(0.00) @map("net_balance") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relationships
  fromUser     User     @relation("SentRequests", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser       User     @relation("ReceivedRequests", fields: [toUserId], references: [id], onDelete: Cascade)
  settlements  FriendSettlement[]

  @@unique([fromUserId, toUserId])
  @@index([fromUserId])
  @@index([toUserId])
  @@map("friends")
}

model FriendSettlement {
  id           String   @id @default(uuid())
  friendshipId String   @map("friendship_id")
  paidById     String   @map("paid_by_id")
  paidToId     String   @map("paid_to_id")
  amount       Decimal  @db.Decimal(12, 2)
  date         DateTime @default(now())
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  friendship   Friend   @relation(fields: [friendshipId], references: [id], onDelete: Cascade)
  paidBy       User     @relation("FriendSentSettlements", fields: [paidById], references: [id], onDelete: Cascade)
  paidTo       User     @relation("FriendReceivedSettlements", fields: [paidToId], references: [id], onDelete: Cascade)

  @@index([friendshipId])
  @@map("friend_settlements")
}

// FriendBalance tracks debts between friends (Splitwise-style)
// The `fromUserId` owes `toUserId` the amount
model FriendBalance {
  id            String   @id @default(uuid())
  fromUserId    String   @map("from_user_id")
  toUserId      String   @map("to_user_id")
  amount        Decimal  @default(0.00) @db.Decimal(12, 2)
  currency      String   @default("USD")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relationships
  fromUser      User     @relation("FriendFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser        User     @relation("FriendTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([fromUserId])
  @@index([toUserId])
  @@map("friend_balances")
}

model Document {
  id               String          @id @default(uuid())
  userId           String          @map("user_id")
  workspaceId      String?         @map("workspace_id")
  filename         String
  originalFilename String          @map("original_filename")
  mimeType         String          @map("mime_type")
  size             Int
  status           String          @default("PROCESSING") // PROCESSING, INDEXED, FAILED
  errorMessage     String?         @map("error_message")
  chunkCount       Int             @default(0) @map("chunk_count")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chunks    DocumentChunk[]

  @@index([userId])
  @@index([workspaceId])
  @@map("documents")
}

model DocumentChunk {
  id          String   @id @default(uuid())
  documentId  String   @map("document_id")
  userId      String   @map("user_id")
  workspaceId String?  @map("workspace_id")
  chunkIndex  Int      @map("chunk_index")
  content     String   @db.Text
  embedding   Json     // Array of 384 float values
  metadata    Json?    // Page number, headers, numeric indicators, etc.
  pageNumber  Int?     @map("page_number")
  createdAt   DateTime @default(now()) @map("created_at")

  document  Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([userId])
  @@index([workspaceId])
  @@map("document_chunks")
}
